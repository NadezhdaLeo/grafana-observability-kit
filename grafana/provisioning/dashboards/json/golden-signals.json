{
  "uid": "golden-signals",
  "title": "Golden Signals",
  "description": "Latency, traffic, errors and saturation for one service, with the alert thresholds drawn on the panels.",
  "tags": [
    "observability-kit",
    "services"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(http_requests_total, service)",
        "query": {
          "query": "label_values(http_requests_total, service)",
          "refId": "service"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "api",
          "value": "api"
        },
        "hide": 0,
        "sort": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(app_up, environment)",
        "query": {
          "query": "label_values(app_up, environment)",
          "refId": "env"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 24,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 25,
      "type": "heatmap",
      "title": "Request latency distribution",
      "description": "A second band appearing above the main one is a slow dependency, not a general slowdown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\", environment=~\"$env\"}[1m]))",
          "legendFormat": "{{le}}",
          "instant": false,
          "range": true,
          "format": "heatmap",
          "editorMode": "code"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange"
        },
        "cellGap": 1,
        "showValue": "never",
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": false
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      }
    },
